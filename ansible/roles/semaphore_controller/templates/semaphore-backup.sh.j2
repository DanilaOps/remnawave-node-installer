#!/usr/bin/env bash
# Nightly backup of the controller's own state.
#
# What is in the archive:
#   - the Semaphore database (the node registry lives here and nowhere else)
#   - a portable export of every project, including its inventory, taken through
#     the API so it can be read and restored without this exact binary
#   - config.json with its secrets stripped, for reference
#   - a manifest with sha256 of every member and the pinned versions
#
# What is deliberately NOT in it: the Semaphore encryption keys, the Ansible
# vault password and the deployer private key. Those belong in a password
# manager. An archive that contains both the encrypted secrets and the key that
# decrypts them is a single file that loses everything at once.
set -euo pipefail

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
work="$(mktemp -d)"
archive="{{ controller_backup_dir }}/semaphore-${stamp}.tar.gz"
cleanup() { rm -rf "$work"; }
trap cleanup EXIT

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*"; }

# --- database ---------------------------------------------------------------
dialect="{{ semaphore_db_dialect }}"
case "$dialect" in
  bolt)
    # Bolt has no online snapshot command, and copying a file the daemon is
    # writing to can capture a torn page. The service is stopped for the copy;
    # it is a single-user UI and the window is under a second.
    log "stopping semaphore for a consistent bolt copy"
    systemctl stop semaphore.service
    cp -p "{{ semaphore_bolt_path }}" "$work/database.boltdb"
    systemctl start semaphore.service
    log "semaphore restarted"
    ;;
  sqlite)
    sqlite3 "{{ semaphore_sqlite_path }}" ".backup '$work/database.sqlite'"
    ;;
  *)
    log "dialect $dialect is external; back it up where it lives"
    printf 'dialect=%s external\n' "$dialect" > "$work/database.external"
    ;;
esac

# --- project export ---------------------------------------------------------
token_file="{{ controller_backup_api_token_path }}"
if [[ -r "$token_file" ]]; then
  token="$(tr -d '\n' < "$token_file")"
  api="{{ controller_backup_api_base }}"
  if projects="$(curl --silent --fail --max-time 30 \
      --header "Authorization: Bearer $token" "$api/projects")"; then
    printf '%s' "$projects" > "$work/projects.json"
    printf '%s' "$projects" \
      | python3 -c 'import json,sys; [print(p["id"]) for p in json.load(sys.stdin)]' \
      | while read -r project_id; do
          curl --silent --fail --max-time 60 \
            --header "Authorization: Bearer $token" \
            "$api/project/$project_id/backup" \
            -o "$work/project-$project_id.json" \
            && log "exported project $project_id (inventory included)" \
            || log "WARNING: project $project_id export failed"
        done
  else
    log "WARNING: the API did not answer; the archive holds the database but no export"
  fi
else
  log "WARNING: no API token at $token_file; the archive holds the database but no portable export"
fi

# --- configuration, without its secrets -------------------------------------
python3 - "{{ semaphore_config_path }}" "$work/config.sanitized.json" <<'PY'
import json, sys
source, target = sys.argv[1:3]
with open(source, encoding="utf-8") as handle:
    config = json.load(handle)
for key in ("cookie_hash", "cookie_encryption", "access_key_encryption"):
    if key in config:
        config[key] = "<redacted: keep this in a password manager>"
with open(target, "w", encoding="utf-8") as handle:
    json.dump(config, handle, indent=2, sort_keys=True)
PY

# --- manifest ---------------------------------------------------------------
{
  printf 'created=%s\n' "$stamp"
  printf 'host=%s\n' "$(hostname -f 2>/dev/null || hostname)"
  printf 'semaphore_version=%s\n' "{{ semaphore_version }}"
  printf 'dialect=%s\n' "$dialect"
  printf 'ansible_version=%s\n' "$({{ semaphore_venv_path }}/bin/ansible --version 2>/dev/null | head -1)"
  printf 'excluded=encryption_keys,vault_password,deployer_private_key\n'
  printf '\nsha256:\n'
  (cd "$work" && sha256sum ./* 2>/dev/null || true)
} > "$work/MANIFEST.txt"

tar -czf "$archive" -C "$work" .
chmod 600 "$archive"
log "wrote $archive ($(stat -c %s "$archive") bytes)"

# --- rotate -----------------------------------------------------------------
find "{{ controller_backup_dir }}" -maxdepth 1 -name 'semaphore-*.tar.gz' -type f \
  -printf '%T@ %p\n' | sort -rn | tail -n +{{ controller_backup_keep + 1 }} \
  | cut -d' ' -f2- | xargs -r rm -f

# --- off-host copy ----------------------------------------------------------
remote="{{ controller_backup_remote }}"
if [[ -z "$remote" ]]; then
  log "ERROR: controller_backup_remote is not set. The archive exists only on the machine it is"
  log "ERROR: meant to protect, which does not survive losing that machine. The Semaphore"
  log "ERROR: inventory is the node registry and exists nowhere else."
  exit 1
fi
# shellcheck disable=SC2086
rsync {{ controller_backup_rsync_options }} "$archive" "$remote" \
  && log "copied to $remote" \
  || { log "ERROR: copying to $remote failed"; exit 1; }
