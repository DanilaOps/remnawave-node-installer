<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="index,follow">
  <title>{{ selfsteal_site.title | default('Cloud Infrastructure') }}</title>
  <style>
    body{margin:0;background:#0b1220;color:#dbeafe;font:16px/1.6 system-ui,sans-serif}
    main{max-width:920px;margin:12vh auto;padding:48px;border:1px solid #1e3a5f;border-radius:18px;background:#111c30}
    h1{font-size:2.5rem;margin:0 0 16px;color:#f8fafc}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:36px}
    section{padding:20px;background:#0d1728;border-radius:12px}@media(max-width:700px){.grid{grid-template-columns:1fr}main{margin:4vh 16px;padding:28px}}
  </style>
</head>
<body><main><h1>{{ selfsteal_site.title | default('Cloud Infrastructure') }}</h1>
<p>Reliable compute, managed networking and observability for distributed services.</p>
<div class="grid"><section>Managed hosting</section><section>Global networking</section><section>24/7 monitoring</section></div>
</main></body></html>

