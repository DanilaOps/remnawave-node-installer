user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
  worker_connections 4096;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /var/log/nginx/access.log;
  sendfile on;
  server_tokens off;
  keepalive_timeout 65;

  server {
    listen 127.0.0.1:9080;
    location = /healthz { access_log off; return 204; }
  }

{% for site in selfsteal_virtual_hosts %}
  server {
    listen 80;
    listen [::]:80;
    server_name {{ site.server_names | join(' ') }};
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
  }

  server {
    listen 127.0.0.1:{{ selfsteal_local_port }} ssl{% if reality_xver | int > 0 %} proxy_protocol{% endif %}{% if loop.first %} default_server{% endif %};
    server_name {{ site.server_names | join(' ') }};
    ssl_certificate /etc/letsencrypt/live/{{ certificate_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ certificate_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
{% if reality_xver | int > 0 %}
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
{% endif %}
    root /var/www/selfsteal/html/{{ site.name }};
    index index.html;
    location / { try_files $uri $uri/ /index.html; }
  }
{% endfor %}

{% for inbound in inbound_specs if inbound.network | default('raw') == 'grpc-tls' %}
  server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ inbound.server_names | default([selfsteal_domain]) | join(' ') }};
    ssl_certificate /etc/letsencrypt/live/{{ certificate_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ certificate_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location /{{ inbound.service_name | default('grpc') }} {
      grpc_pass grpc://127.0.0.1:{{ inbound.port }};
      grpc_set_header Host $host;
      grpc_set_header X-Real-IP $remote_addr;
    }
    location / { root /var/www/selfsteal/html/{{ selfsteal_virtual_hosts[0].name }}; try_files $uri /index.html; }
  }
{% endfor %}
}

