---
# Copy to panel.yml in this directory and fill in the real values.
# panel.yml is git-ignored: the panel URL, controller address and node zone
# must not end up in a published repository.
# One Remnawave panel serves every node, so panel-wide values live here instead of
# being repeated per node or per group.

remnawave_panel_url: https://panel.example.com
remnawave_panel_token: "{{ vault_remnawave_panel_token }}"

# Shared Xray JSON that carries the routing. Every published Host is bound to it;
# a node only adds its own inbound. See ansible/README.md.
config_profile_mode: shared
profile_name: Default August
config_profile_create: false
config_profile_require_routing: true

# Source addresses allowed to reach a node. The controller's own address is
# discovered from the live SSH connection, so it never has to be maintained by
# hand and a controller with a changing address cannot lock itself out. Add
# stable addresses that must keep SSH access even when nobody runs from them
# (a second operator, a jump host) to management_cidrs_extra; set
# management_cidrs explicitly to opt out of the discovery entirely.
management_cidrs_extra: []
# The panel's address, allowed to reach NODE_PORT. Keep it explicit: resolving it
# from the panel URL would silently point at a CDN if the panel ever moves behind
# one, which would leave the node unreachable for the panel itself.
remnawave_panel_cidrs:
  - 198.51.100.20/32

# All node domains live in this zone; selfsteal_domain is derived from it.
node_domain_zone: example.com

acme_email: ops@example.com
internal_squad_name: Default
