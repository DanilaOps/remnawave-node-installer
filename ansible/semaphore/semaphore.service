[Unit]
Description=Semaphore UI for Remnawave automation
Documentation=https://semaphoreui.com/docs/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=semaphore
Group=semaphore
WorkingDirectory=/var/lib/semaphore
Environment=HOME=/var/lib/semaphore
Environment=PATH=/opt/remnawave-node-installer/ansible/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=SEMAPHORE_INTERFACE=127.0.0.1
Environment=SEMAPHORE_PORT=:3000
ExecStart=/usr/bin/semaphore server --config=/etc/semaphore/config.json
Restart=on-failure
RestartSec=5s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/cache/semaphore /var/lib/semaphore
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
