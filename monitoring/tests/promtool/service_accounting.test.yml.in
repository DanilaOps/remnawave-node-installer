# promtool unit tests for the accounting contract, run against the real PromQL
# engine on synthetic series. RULE_DIR is replaced by monitoring/tests/test_service_accounting.sh
# with the directory holding the rules this repository ships.
#
# The fixture is the one the contract is written for: one gigabit per second of
# user traffic entering at a RU node, crossing a bridge, and leaving at a DE
# node. Two node counters see it, so the physical figure is two gigabits. The
# bridge's own tag counter measures exactly the duplication, so the service
# figure is one. If a change ever makes the service figure two, this fails.
rule_files:
  - RULE_DIR/recording-rules.yml

evaluation_interval: 30s

tests:
  - interval: 30s
    name: one user gigabit through RU -> bridge -> DE
    input_series:
      # 125 MB/s = 1 Gbit/s. 3.75e9 bytes per 30s step.
      - series: 'remnawave_node_inbound_download_bytes{node_uuid="uuid-ru01"}'
        values: "0+3750000000x40"
      - series: 'remnawave_node_inbound_download_bytes{node_uuid="uuid-de01"}'
        values: "0+3750000000x40"
      - series: 'remnawave_node_inbound_upload_bytes{node_uuid="uuid-ru01"}'
        values: "0+3750000000x40"
      - series: 'remnawave_node_inbound_upload_bytes{node_uuid="uuid-de01"}'
        values: "0+3750000000x40"
      # The same bytes, leaving RU-01 under the bridge's own tag.
      - series: 'remnawave_node_outbound_download_bytes{node_uuid="uuid-ru01",tag="RU01-40913C-DE-BRIDGE"}'
        values: "0+3750000000x40"
      - series: 'remnawave_node_outbound_upload_bytes{node_uuid="uuid-ru01",tag="RU01-40913C-DE-BRIDGE"}'
        values: "0+3750000000x40"
      # The mapping the capacity exporter publishes.
      - series: 'august_node_identity{node="RU-01",node_uuid="uuid-ru01",pool="RU_ENTRY"}'
        values: "1x40"
      - series: 'august_node_identity{node="DE-01",node_uuid="uuid-de01",pool="DE"}'
        values: "1x40"
      - series: 'august_bridge_info{name="RU01-DE",node="RU-01",source_node="RU-01",destination_node="DE-01",tag="RU01-40913C-DE-BRIDGE"}'
        values: "1x40"
      - series: 'august_node_active{node="RU-01",pool="RU_ENTRY"}'
        values: "1x40"
      - series: 'august_node_active{node="DE-01",pool="DE"}'
        values: "1x40"

    promql_expr_test:
      # Identity: the UUIDs resolve to names, once each.
      - expr: count(august:node_uuid_name)
        eval_time: 10m
        exp_samples:
          - labels: "{}"
            value: 2

      # Each node sees the gigabit that crosses it.
      - expr: august:node_used_bps{direction="download"}
        eval_time: 10m
        exp_samples:
          - labels: 'august:node_used_bps{direction="download",node="DE-01"}'
            value: 1.0e+09
          - labels: 'august:node_used_bps{direction="download",node="RU-01"}'
            value: 1.0e+09

      # Physical: every leg, counted as many times as the traffic crosses one.
      - expr: august:physical_usage_bps{direction="download"}
        eval_time: 10m
        exp_samples:
          - labels: 'august:physical_usage_bps{direction="download"}'
            value: 2.0e+09

      # The bridge, measured by its own tag on its source node.
      - expr: august:bridge_used_bps{direction="download"}
        eval_time: 10m
        exp_samples:
          - labels: 'august:bridge_used_bps{direction="download",name="RU01-DE",node="RU-01",tag="RU01-40913C-DE-BRIDGE"}'
            value: 1.0e+09

      - expr: august:bridge_usage_total_bps{direction="download"}
        eval_time: 10m
        exp_samples:
          - labels: 'august:bridge_usage_total_bps{direction="download"}'
            value: 1.0e+09

      # THE CONTRACT. One user gigabit is one gigabit of service usage.
      - expr: august:service_usage_bps{direction="download"}
        eval_time: 10m
        exp_samples:
          - labels: 'august:service_usage_bps{direction="download"}'
            value: 1.0e+09

      - expr: august:service_usage_bps{direction="upload"}
        eval_time: 10m
        exp_samples:
          - labels: 'august:service_usage_bps{direction="upload"}'
            value: 1.0e+09

      # Per pool, so a pool figure is not the service figure either.
      - expr: august:pool_used_bps{direction="download"}
        eval_time: 10m
        exp_samples:
          - labels: 'august:pool_used_bps{direction="download",pool="DE"}'
            value: 1.0e+09
          - labels: 'august:pool_used_bps{direction="download",pool="RU_ENTRY"}'
            value: 1.0e+09

  - interval: 30s
    name: traffic from a UUID nothing can name is kept, not folded away
    input_series:
      - series: 'remnawave_node_inbound_download_bytes{node_uuid="uuid-unknown"}'
        values: "0+3750000000x40"
    promql_expr_test:
      # No mapping exists, so nothing is attributed...
      - expr: count(august:node_used_bps)
        eval_time: 10m
        exp_samples: []
      # ...and the gigabits are still visible, with their UUID.
      - expr: august:unmapped_traffic_bps{direction="download"}
        eval_time: 10m
        exp_samples:
          - labels: 'august:unmapped_traffic_bps{direction="download",node_uuid="uuid-unknown"}'
            value: 1.0e+09
      # And the service figure does not silently include them.
      - expr: august:service_usage_bps
        eval_time: 10m
        exp_samples: []

  - interval: 30s
    name: a direct node with no bridge is counted once
    input_series:
      - series: 'remnawave_node_inbound_download_bytes{node_uuid="uuid-pl01"}'
        values: "0+3750000000x40"
      - series: 'august_node_identity{node="PL-01",node_uuid="uuid-pl01",pool="PL"}'
        values: "1x40"
      - series: 'august_node_active{node="PL-01",pool="PL"}'
        values: "1x40"
    promql_expr_test:
      - expr: august:service_usage_bps{direction="download"}
        eval_time: 10m
        exp_samples:
          - labels: 'august:service_usage_bps{direction="download"}'
            value: 1.0e+09
      - expr: august:physical_usage_bps{direction="download"}
        eval_time: 10m
        exp_samples:
          - labels: 'august:physical_usage_bps{direction="download"}'
            value: 1.0e+09

  - interval: 30s
    name: required series detection sees an absent mapping
    input_series:
      - series: 'remnawave_node_inbound_download_bytes{node_uuid="uuid-ru01"}'
        values: "0+3750000000x40"
    promql_expr_test:
      - expr: august:required_series_present{series="node_uuid_mapping"}
        eval_time: 10m
        exp_samples:
          - labels: 'august:required_series_present{series="node_uuid_mapping"}'
            value: 0
      - expr: august:required_series_present{series="remnawave_inbound_download"}
        eval_time: 10m
        exp_samples:
          - labels: 'august:required_series_present{series="remnawave_inbound_download"}'
            value: 1
